    "inputs": {
      "crop": "center",
      "clip_vision": ["4", 0],
      "image": ["5", 0]
    },
    "class_type": "CLIPVisionEncode",
    "_meta": {
      "title": "Encode Subject"
    }
  },
  "7": {
    "inputs": {
      "model": ["2", 0],
      "model_patch": ["3", 0],
      "clip_vision_output": ["6", 0]
