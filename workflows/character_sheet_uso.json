    "class_type": "USOStyleReference",
    "_meta": {
      "title": "USO Subject Reference"
    }
  },
  "8": {
    "inputs": {
      "text": "character turnaround sheet of this exact character",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "PROMPT"
    }
  },
  "9": {
    "inputs": {
      "guidance": 3.5,
      "conditioning": ["8", 0]
    },
    "class_type": "FluxGuidance",
    "_meta": {
      "title": "FluxGuidance"
    }
  },
  "10": {
    "inputs": {
      "upscale_method": "lanczos",
      "megapixels": 0.26,
      "resolution_steps": 1,
      "image": ["5", 0]
    },
    "class_type": "ImageScaleToTotalPixels",
    "_meta": {
      "title": "Scale Subject"
    }
  },
  "11": {
    "inputs": {
      "pixels": ["10", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEEncode",
    "_meta": {
      "title": "Encode Subject Latent"
    }
  },
  "12": {
    "inputs": {
      "conditioning": ["9", 0],
      "latent": ["11", 0]
    },
    "class_type": "ReferenceLatent",
    "_meta": {
      "title": "Subject Reference Latent"
    }
  },
  "13": {
    "inputs": {
      "text": "",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative (unused at cfg 1)"
    }
  },
  "14": {
    "inputs": {
      "width": 1536,
      "height": 1024,
      "batch_size": 1
    },
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "SIZE"
    }
  },
  "15": {
    "inputs": {
      "seed": 1,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["7", 0],
      "positive": ["12", 0],
      "negative": ["13", 0],
      "latent_image": ["14", 0]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "SEED"
    }
  },
  "16": {
    "inputs": {
      "samples": ["15", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "17": {
    "inputs": {
      "filename_prefix": "pique_sheet",
      "images": ["16", 0]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    }
